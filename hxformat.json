{
	"indentation": {
		"character": "tab",
		"tabWidth": 4,
		"trailingWhitespace": false,
		"alignInlineSwitchCaseBody": true
	},
	"emptyLines": {
		"maxAnywhereInFile": 2,
		"afterBlocks": "remove",
		"afterLeftCurly": "keep",
		"beforeRightCurly": "keep",
		"classEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"interfaceEmptyLines": {
			"beginType": 1,
			"endType": 1
		},
		"abstractEmptyLines": {
			"beginType": 1,
			"endType": 1
		}
	},
